# Frontend/public key
VITE_SUPABASE_URL=https://PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server runtime
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
PUBLIC_APP_URL=https://check.example.com

# Cartografia — ArcGIS Location Platform (MapLibre no frontend).
# Chave de aplicação web (Basemap Styles), restrita por referrer.
# Guardada apenas em Lovable Secrets e entregue ao navegador pela função
# de servidor arcgisWebKey — nunca versionada:
ARCGIS_WEB_API_KEY=REPLACE_IN_LOVABLE_SECRETS
# Chave usada apenas no servidor para renderizar o snapshot estático do mapa:
ARCGIS_STATIC_MAPS_API_KEY=AAPK-REPLACE_IN_LOVABLE_SECRETS

# Webi NOC IA — somente no runtime do servidor/Lovable Secrets.
# Nunca use prefixo VITE_ nestas variáveis.
OPENAI_API_KEY=sk-proj-REPLACE_IN_LOVABLE_SECRETS
OPENAI_MODEL_TRIAGE=gpt-5.6-luna
OPENAI_MODEL_REVIEW=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MODEL_VISION=gpt-4o-mini

# Cascata de IA — o gateway tenta nesta ordem e usa a primeira chave presente:
# lovable -> openrouter -> groq -> github -> openai
LOVABLE_API_KEY=REPLACE_IN_LOVABLE_SECRETS
OPENROUTER_API_KEY=REPLACE_IN_LOVABLE_SECRETS
GROQ_API_KEY=REPLACE_IN_LOVABLE_SECRETS
GITHUB_MODELS_TOKEN=REPLACE_IN_LOVABLE_SECRETS
# llama-3.3-70b-versatile do Groq nao le imagens; visao usa modelo separado:
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct
# Timeout por chamada de IA (ms). Sem isto um provedor lento trava o lote.
AI_REQUEST_TIMEOUT_MS=45000
