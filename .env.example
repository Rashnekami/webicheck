# Frontend/public key
VITE_SUPABASE_URL=https://PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Server runtime
SUPABASE_URL=https://PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx
PUBLIC_APP_URL=https://check.example.com

# Cartografia — ArcGIS Location Platform (MapLibre no frontend).
# Chave de aplicação web (Basemap Styles), restrita por referrer.
# Guardada apenas em Lovable Secrets e entregue ao navegador pela função
# de servidor arcgisWebKey — nunca versionada:
ARCGIS_WEB_API_KEY=REPLACE_IN_LOVABLE_SECRETS
# Chave usada apenas no servidor para renderizar o snapshot estático do mapa:
ARCGIS_STATIC_MAPS_API_KEY=AAPK-REPLACE_IN_LOVABLE_SECRETS

# Webi NOC IA — somente no runtime do servidor/Lovable Secrets.
# Nunca use prefixo VITE_ nestas variáveis.
OPENAI_API_KEY=sk-proj-REPLACE_IN_LOVABLE_SECRETS
OPENAI_MODEL_TRIAGE=gpt-5.6-luna
OPENAI_MODEL_REVIEW=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
